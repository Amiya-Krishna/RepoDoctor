generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  password          String
  githubId          String?      @unique
  githubUsername    String?
  githubAccessToken String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  repositories      Repository[]
  privacySettings   PrivacySettings?
  notifications     Notification[]

  @@map("users")
}

model Repository {
  id            String                  @id @default(cuid())
  githubId      String
  name          String
  fullName      String
  ownerLogin    String
  defaultBranch String
  private       Boolean                 @default(false)
  htmlUrl       String
  cloneUrl      String
  userId        String
  autoScan      Boolean                 @default(false)
  lastScheduledScanAt DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  analyses      Analysis[]
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryChunks  RepositoryMemoryChunk[]

  @@unique([userId, githubId])
  @@index([githubId])
  @@index([userId])
}

model Analysis {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  status    AnalysisStatus @default(PENDING)
  sourceRef String?

  projectType    String?
  language       String?
  packageManager String?
  framework      String?
  testFramework  String?
  linter         String?

  hasTypeScript Boolean @default(false)

  sourceFileCount Int @default(0)
  testFileCount   Int @default(0)

  snapshot Json?

  startedAt   DateTime?
  completedAt DateTime?

  bugFindings         BugFinding[]
  securityFindings    SecurityFinding[]
  generatedTests      GeneratedTest[]
  riskAssessments     RiskAssessment[]
  fixProposals        FixProposal[]
  verificationResults VerificationResult[]
  pullRequests        PullRequest[]
  repairJobs          RepairJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model BugFinding {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title       String
  description String

  category String
  severity String

  filePath  String
  lineStart Int
  lineEnd   Int

  evidence     String
  suggestedFix String

  confidence Float

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([severity])
}

model SecurityFinding {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title       String
  description String

  category String
  severity String

  filePath  String
  lineStart Int
  lineEnd   Int

  evidence     String
  suggestedFix String

  confidence Float

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([severity])
  @@index([category])
}

model GeneratedTest {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title       String
  description String

  type String

  filePath       String
  targetFunction String?

  testCode String

  rationale String

  confidence Float

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([type])
}

model RiskAssessment {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  findingId String
  source    String

  score    Int
  level    String
  priority String

  factors Json

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([findingId])
  @@index([level])
  @@index([priority])
}

model FixProposal {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  findingId String
  source    String

  title   String
  summary String

  risk       String
  confidence Float

  reasoning String

  changes Json

  status String @default("PROPOSED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisId])
  @@index([findingId])
  @@index([status])
}

model VerificationResult {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  findingId     String
  fixProposalId String

  status String

  title   String
  summary String

  confidence Float

  evidence Json

  reasoning String

  testPassed         Boolean
  regressionDetected Boolean

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([findingId])
  @@index([fixProposalId])
  @@index([status])
}

model DockerTestRun {
  id String @id @default(cuid())

  analysisId String?

  repositoryPath String

  testCommand Json

  success  Boolean
  exitCode Int?
  stdout   String
  stderr   String

  durationMs Int
  timedOut   Boolean

  createdAt DateTime @default(now())

  @@index([success])
  @@index([timedOut])
  @@index([analysisId])
}

model RepairAttempt {
  id String @id @default(cuid())

  analysisId String
  findingId  String

  attemptNumber Int

  status String

  fixProposalId        String?
  dockerTestRunId      String?
  verificationResultId String?

  failureReason String?

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([findingId])
  @@index([attemptNumber])
  @@index([status])
}

model PullRequest {
  id String @id @default(cuid())

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  findingId            String
  fixProposalId        String
  verificationResultId String

  repositoryOwner String
  repositoryName  String

  branchName String
  baseBranch String

  commitSha String

  pullRequestNumber Int
  pullRequestUrl    String

  title  String
  status String @default("OPEN")

  createdAt DateTime @default(now())

  @@unique([analysisId, findingId])
  @@index([analysisId])
  @@index([findingId])
  @@index([fixProposalId])
  @@index([verificationResultId])
  @@index([status])
}

model RepairJob {
  id String @id @default(cuid())

  analysisId String
  findingId  String

  status String

  currentAttempt Int                @default(0)
  maxAttempts    Int                @default(3)
  attemptHistory RepairJobAttempt[]

  errorMessage String?

  // Approval gate: a VERIFIED repair waits here until the owner approves it.
  fixProposalId        String?
  verificationResultId String?
  testCommand          Json?
  workingDirectory     String?
  approvedAt           DateTime?
  approvedBy           String?
  pullRequestUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  analysis  Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([findingId])
  @@index([status])
}

model RepairJobAttempt {
  id                 String   @id @default(cuid())
  repairJobId        String
  attemptNumber      Int
  status             String
  testPassed         Boolean
  verificationStatus String
  summary            String   @db.Text
  durationMs         Int?
  createdAt          DateTime @default(now())

  repairJob RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@unique([repairJobId, attemptNumber])
  @@index([repairJobId, createdAt])
}

model RepositoryMemoryChunk {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  sourceType  String
  sourcePath  String
  contentHash String
  content     String   @db.Text
  embedding   Json
  createdAt   DateTime @default(now())

  @@unique([repositoryId, contentHash])
  @@index([repositoryId, sourceType])
}

model SecurityAuditEvent {
  id          String   @id @default(cuid())
  eventType   String
  actorId     String?
  repositoryId String?
  repairJobId String?
  outcome     String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([repositoryId, createdAt])
  @@index([repairJobId, createdAt])
}

model PrivacySettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NONE = no code leaves the server (safest default); CLOUD = hosted LLM
  // providers after informed consent; LOCAL = self-hosted OpenAI-compatible endpoint.
  dataMode       String    @default("NONE")
  consentVersion Int?
  consentedAt    DateTime?
  retentionDays  Int       @default(30)
  notifyOnCritical Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model WebhookDelivery {
  deliveryId String   @id
  event      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  severity     String    @default("INFO")
  title        String
  message      String
  repositoryId String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
