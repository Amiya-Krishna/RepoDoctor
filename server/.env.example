PORT=5000

# Local dev (Postgres running via docker-compose, port published to host):
DATABASE_URL=postgresql://repodoctor:repodoctor@localhost:5432/repodoctor?schema=public
# When the server itself runs inside the Docker network, use the service name instead:
# DATABASE_URL=postgresql://repodoctor:repodoctor@postgres:5432/repodoctor?schema=public

JWT_SECRET=your_secret
JWT_EXPIRES_IN=1d

GITHUB_CLIENT_ID=Ov23xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback