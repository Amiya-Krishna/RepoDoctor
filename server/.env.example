# API port. 4000 for both `npm run dev` and Docker Compose (inside the container network).
# Nobody opens this port in a browser: the app is always http://localhost:8080
# (Vite dev server locally, nginx in Docker; both proxy /api and /socket.io to the API on 4000).
PORT=4000

# PostgreSQL connection string. Neon example (use the direct, non-pooled endpoint):
#   postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&connect_timeout=30
# Local PostgreSQL example:
#   postgresql://repodoctor:change_me@localhost:5432/repodoctor?schema=public
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&connect_timeout=30
# Compose stack: the root .env DATABASE_URL overrides this value for the containers.

JWT_SECRET=replace_with_a_long_random_string
# Lifetime of login tokens: digits + s/m/h/d (invalid values fall back to 1d)
JWT_EXPIRES_IN=1d

GITHUB_CLIENT_ID=Ov23xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Must equal the OAuth app's Authorization callback URL. Same value for Docker and local development.
GITHUB_CALLBACK_URL=http://localhost:8080/api/github/callback

OPENROUTER_API_KEY=
# Exact model ID from https://openrouter.ai/models (copy it with the ":free" suffix; a truncated ID gives
# "not a valid model ID"). Empty = the `openrouter/free` router. Suggested: nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_BASE_BRANCH=main
GITHUB_TOKEN=your_github_token
# REQUIRED. 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it the app refuses to store a GitHub token (and refuses to start in production).
GITHUB_TOKEN_ENCRYPTION_KEY=
# Development only, never in production: store tokens unencrypted when no key is set.
# ALLOW_PLAINTEXT_TOKENS=true

# Background processing (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
SCAN_WORKER_CONCURRENCY=2

REPAIR_TEST_TIMEOUT_MS=420000
# GitHub webhook signature secret configured in GitHub repository settings
# At least 20 random characters; production refuses to start without a real value.
GITHUB_WEBHOOK_SECRET=replace_with_a_random_secret
# Browser origin of the client (CORS, Socket.IO, redirect after GitHub sign-in); no trailing slash.
# Same value for Docker and local development: http://localhost:8080
FRONTEND_URL=http://localhost:8080

# --- Privacy / AI -------------------------------------------------------------
# No code is sent to any model until each user chooses a mode and consents in the UI.
# Cloud mode uses the provider keys above. Self-hosted mode uses an OpenAI-compatible
# endpoint you run yourself (Ollama: http://ollama:11434/v1). There is no fallback
# from self-hosted to cloud.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=

# --- Automation ---------------------------------------------------------------
# Hours between scheduled scans of repositories whose owner enabled automatic scanning.
AUTO_SCAN_INTERVAL_HOURS=24

# --- Sandbox (repair worker host only) -----------------------------------------
# uid:gid the repository's tests run as inside the sandbox container. Empty = image default.
REPAIR_SANDBOX_USER=1000:1000
REPAIR_TEST_MEMORY=512m
REPAIR_TEST_CPUS=1

# --- Local evaluation only ------------------------------------------------------
# Production requires an https FRONTEND_URL. Set true ONLY for http://localhost evaluation.
# ALLOW_INSECURE_HTTP=true
