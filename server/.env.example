PORT=5000

# PostgreSQL 16 you run yourself (docker-compose.yml does NOT start a database).
# Local dev: server on the host, Postgres on localhost.
DATABASE_URL=postgresql://repodoctor:change_me@localhost:5432/repodoctor?schema=public
# Compose stack: set DATABASE_URL in the ROOT .env (see ../.env.example) instead.

JWT_SECRET=replace_with_a_long_random_string
# Lifetime of login tokens: digits + s/m/h/d (invalid values fall back to 1d)
JWT_EXPIRES_IN=1d

GITHUB_CLIENT_ID=Ov23xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_BASE_BRANCH=main
GITHUB_TOKEN=your_github_token
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

# Background processing (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
SCAN_WORKER_CONCURRENCY=2

# GitHub webhook signature secret configured in GitHub repository settings
GITHUB_WEBHOOK_SECRET=replace_with_a_random_secret
FRONTEND_URL=http://localhost:5173
