# Root environment for `docker compose` (copy to .env; .env is git-ignored).
# Also copy server/.env.example to server/.env and fill it in.

# --- Database (choose one) ---------------------------------------------------
# A) Neon (or any external PostgreSQL). In the Neon console copy the connection
#    string of the DIRECT (non-pooled) endpoint: the host has no "-pooler" part.
#    Keep sslmode=require; connect_timeout gives a scaled-to-zero compute time to wake.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&connect_timeout=30

# B) Bundled PostgreSQL: comment out DATABASE_URL above, set a URL-safe password
#    (letters, digits, - and _) and start with: docker compose --profile bundled-db up --build -d
# POSTGRES_PASSWORD=change_me_long_random

# Password for the bundled Redis service (required).
REDIS_PASSWORD=change_me_long_random
