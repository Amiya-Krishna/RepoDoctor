# Root environment for `docker compose` (copy to .env; .env is git-ignored).
# Also copy server/.env.example to server/.env and fill it in.

# PostgreSQL is NOT part of the compose file. Point this at a database the
# containers can reach, e.g. one on the host:
#   postgresql://repodoctor:<password>@host.docker.internal:5432/repodoctor?schema=public
# (on Linux add `extra_hosts: ["host.docker.internal:host-gateway"]` or use the host's IP).
DATABASE_URL=postgresql://repodoctor:change_me@host.docker.internal:5432/repodoctor?schema=public

# Password for the bundled Redis service (required).
REDIS_PASSWORD=change_me_long_random
